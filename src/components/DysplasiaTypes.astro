---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface DysplasiaGroup {
  /** The cell classes the features below are assessed on. */
  group: string;
  /** Folder the example crops for this group live in. */
  key: string;
  types: { name: string; key: string }[];
}

interface Props {
  groups: DysplasiaGroup[];
}
const { groups } = Astro.props;

// Example crops, keyed `<group>/<type>`. A type with no crop yet still lists
// its name, so the section reads correctly before the imagery lands.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/dysplasias/*/*.webp",
  { eager: true },
);
const examples = new Map<string, ImageMetadata>();
for (const path of Object.keys(files)) {
  const parts = path.split("/");
  examples.set(
    `${parts.at(-2)}/${parts.at(-1)!.replace(/\.webp$/, "")}`,
    files[path]!.default,
  );
}
---

<dl>
  {
    groups.map((entry) => (
      <div class="group">
        <dt>{entry.group}</dt>
        <dd>
          <ul>
            {entry.types.map((type) => {
              const image = examples.get(`${entry.key}/${type.key}`);
              return (
                <li>
                  {image && (
                    <Image
                      src={image}
                      alt=""
                      width={160}
                      height={160}
                      loading="lazy"
                    />
                  )}
                  <span>{type.name}</span>
                </li>
              );
            })}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  dl {
    display: flex;
    flex-direction: column;
    gap: var(--element-padding);
    margin: 0;
    width: 100%;
  }

  .group {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--element-padding);
    align-items: center;
  }

  /* The group runs up the side of its own examples rather than sitting above
     them, which is what keeps a row of one crop from reading as a caption for
     the row above it. */
  dt {
    writing-mode: vertical-rl;
    rotate: 180deg;
    justify-self: center;
    text-align: center;
    font-weight: 600;
    color: var(--accent-2);
    /* Turned on its side the inline axis runs down the page, so this is what
       wraps a long group name onto a second line instead of letting it set the
       height of its own row. */
    max-inline-size: 8rem;
  }
  dd {
    margin: 0;
    min-width: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 10rem));
    gap: var(--element-padding);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    text-align: center;
  }
  li :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--small-border-radius);
    display: block;
  }
</style>
