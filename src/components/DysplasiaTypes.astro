---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface DysplasiaRow {
  /**
   * What the row is about: usually a group of cell classes and the features
   * found in it, but a feature common to many groups is worth turning around,
   * so the row is the feature and the captions are the classes.
   */
  label: string;
  /** `key` locates the crop, as `<group>/<feature>`; `name` captions it. */
  items: { name: string; key: string }[];
}

interface Props {
  rows: DysplasiaRow[];
}
const { rows } = Astro.props;

// Example crops, keyed `<group>/<feature>`. An item with no crop yet still
// shows its caption, so the section reads correctly before the imagery lands.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/dysplasias/*/*.webp",
  { eager: true },
);
const examples = new Map<string, ImageMetadata>();
for (const path of Object.keys(files)) {
  const parts = path.split("/");
  examples.set(
    `${parts.at(-2)}/${parts.at(-1)!.replace(/\.webp$/, "")}`,
    files[path]!.default,
  );
}
---

<dl>
  {
    rows.map((row) => (
      <div class="group">
        <dt>{row.label}</dt>
        <dd>
          <ul>
            {row.items.map((item) => {
              const image = examples.get(item.key);
              return (
                <li>
                  {image ? (
                    <Image
                      src={image}
                      alt=""
                      width={160}
                      height={160}
                      loading="lazy"
                    />
                  ) : (
                    <div class="pending" />
                  )}
                  <span>{item.name}</span>
                </li>
              );
            })}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /* Every group shares this one grid rather than laying out its own, so the
     label column is as wide as the widest label and the examples of each row
     start on the same axis. A group with its own grid would size that column to
     its own label, and the one name long enough to wrap would step its whole
     row out of line with the others. */
  dl {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--element-padding);
    align-items: center;
    margin: 0;
    width: 100%;
  }

  .group {
    display: contents;
  }

  /* The group runs up the side of its own examples rather than sitting above
     them, which is what keeps a row of one crop from reading as a caption for
     the row above it. */
  dt {
    rotate: -90deg;
    justify-self: center;
    text-align: center;
    font-weight: 700;
    line-height: 1;
    color: var(--accent-2);
    width: 8rem;
  }
  dd {
    margin: 0;
    min-width: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 10rem));
    gap: var(--element-padding);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    text-align: center;
  }
  li :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--small-border-radius);
    display: block;
  }

  /* An item whose crop the reference slides did not hold still occupies the
     image slot, so it does not pull its own caption up out of the line the rest
     of the row's captions sit on. */
  .pending {
    aspect-ratio: 1;
  }

  /* A name too long for its column wraps, and the row is read across rather
     than down, so the two lines want to stay one label rather than open up into
     the spacing body copy uses. */
  li span {
    line-height: 1.2;
  }
</style>
