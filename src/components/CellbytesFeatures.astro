---
import CellularityIcon from "~src/assets/icons/assessments/cellularity.svg";
import ClustersIcon from "~src/assets/icons/assessments/clusters.svg";
import MegakaryocytesIcon from "~src/assets/icons/assessments/megakaryocyte-count.svg";
import ShapeIcon from "~src/assets/icons/assessments/shape.svg";
import SizeIcon from "~src/assets/icons/assessments/size.svg";
import SufficiencyIcon from "~src/assets/icons/assessments/sample-sufficiency.svg";

import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import Glyphs from "~src/components/AssessmentGlyphs.astro";
import Dysplasias from "~src/components/DysplasiaTypes.astro";
import CellClasses, {
  type Lineage,
} from "~src/components/CellClassBrowser.astro";

// The lineage colors the application paints cell boxes and differentials with,
// so a reader recognizes the same grouping in the product.
const ERYTHROID = "#f0ae92";
const BLASTS = "#ff4488";
const GRANULOCYTIC = "#afc9f1";
const LYMPHOID = "#b4d295";
const MONOCYTIC = "#fff09c";
const OTHER = "#cccccc";

const BONE_MARROW: Lineage[] = [
  {
    name: "Erythroid",
    color: ERYTHROID,
    dysplasia: true,
    members: [
      { name: "Proerythroblast", key: "bm_proerythroblast" },
      { name: "Erythroblast", key: "bm_erythroblast" },
    ],
  },
  {
    name: "Blasts",
    color: BLASTS,
    dysplasia: true,
    members: [
      { name: "Blast", key: "bm_blast" },
      { name: "Promonocyte", key: "bm_promonocyte" },
    ],
  },
  {
    name: "Granulocytic",
    color: GRANULOCYTIC,
    dysplasia: true,
    members: [
      { name: "Promyelocyte", key: "bm_promyelocyte" },
      { name: "Myelocyte", key: "bm_myelocyte" },
      { name: "Metamyelocyte", key: "bm_metamyelocyte" },
      { name: "Neutrophil", key: "bm_neutrophil" },
      { name: "Basophil", key: "bm_basophil" },
      {
        name: "Eosinophils",
        members: [
          { name: "Mature", key: "bm_eosinophil" },
          { name: "Immature", key: "bm_eosinophil_immature" },
        ],
      },
    ],
  },
  {
    name: "Lymphoid",
    color: LYMPHOID,
    dysplasia: true,
    members: [
      { name: "Lymphocyte", key: "bm_lymphocyte" },
      { name: "Plasma cell", key: "bm_plasma_cell" },
    ],
  },
  {
    name: "Monocytic",
    color: MONOCYTIC,
    members: [
      { name: "Monocyte", key: "bm_monocyte" },
      { name: "Macrophage", key: "bm_macrophage" },
    ],
  },
  {
    name: "Other",
    color: OTHER,
    members: [
      { name: "Artefact", key: "bm_artefact" },
      { name: "Megakaryocyte *", key: "bm_megakaryocyte" },
    ],
  },
];

const PERIPHERAL_BLOOD: Lineage[] = [
  {
    name: "Erythroblast",
    key: "pb_erythroblast",
    color: ERYTHROID,
    members: [],
  },
  {
    name: "Blasts",
    color: BLASTS,
    members: [
      { name: "Blast", key: "pb_blast" },
      { name: "Promonocyte", key: "pb_promonocyte" },
    ],
  },
  {
    name: "Granulocytic",
    color: GRANULOCYTIC,
    members: [
      { name: "Promyelocyte", key: "pb_promyelocyte" },
      { name: "Myelocyte", key: "pb_myelocyte" },
      { name: "Metamyelocyte", key: "pb_metamyelocyte" },
      {
        name: "Neutrophil",
        members: [
          { name: "Band", key: "pb_band_neutrophil" },
          { name: "Segmented", key: "pb_segmented_neutrophil" },
        ],
      },
      { name: "Basophil", key: "pb_basophil" },
      { name: "Eosinophils", key: "pb_eosinophil" },
    ],
  },
  {
    name: "Lymphoid",
    color: LYMPHOID,
    members: [
      { name: "Lymphocyte", key: "pb_lymphocyte" },
      { name: "Plasma cell", key: "pb_plasma_cell" },
    ],
  },
  {
    name: "Monocyte",
    key: "pb_monocyte",
    color: MONOCYTIC,
    members: [],
  },
  {
    name: "Artefact",
    key: "pb_artefact",
    color: OTHER,
    members: [],
  },
];

/**
 * The dysplasia features reported for each group of cell classes, mirroring the
 * dysplasia structure the application assesses. Bone marrow covers two groups
 * that a blood smear does not: erythroblasts and megakaryocytes.
 */
const BM_DYSPLASIAS = [
  {
    group: "Blasts / immature granulocytes",
    types: ["Bilobed nucleus", "Auer rods", "Vacuolated"],
  },
  {
    group: "Erythroblasts",
    types: ["N:C asynchrony", "Dysmorphic", "Multinucleated", "Vacuolated"],
  },
  {
    group: "Megakaryocytes",
    types: ["Separated nuclei", "Hypolobated nuclei"],
  },
  { group: "Mature granulocytes", types: ["Vacuolated"] },
  { group: "Lymphocytes", types: ["Vacuolated"] },
  { group: "Plasma cells", types: ["Vacuolated"] },
];

const PB_DYSPLASIAS = [
  {
    group: "Blasts / immature granulocytes",
    types: ["Bilobed nucleus", "Auer rods", "Vacuolated"],
  },
  { group: "Mature granulocytes", types: ["Vacuolated"] },
  { group: "Lymphocytes", types: ["Vacuolated"] },
  { group: "Plasma cells", types: ["Vacuolated"] },
];

/**
 * The measurements that are not a cell class, each with the glyph that stands
 * for it. `art` is the artwork.css class that repaints the icon from theme
 * tokens; the icons carry their exported colors otherwise.
 */
const MORPHOLOGY = [
  { name: "Size", icon: SizeIcon, art: "art-icon-size" },
  { name: "Shape", icon: ShapeIcon, art: "art-icon-shape" },
];
const SAMPLE_LEVEL = [
  { name: "Clusters", icon: ClustersIcon, art: "art-icon-clusters" },
  {
    name: "Megakaryocyte count",
    icon: MegakaryocytesIcon,
    art: "art-icon-megakaryocytes",
  },
  { name: "Cellularity", icon: CellularityIcon, art: "art-icon-cellularity" },
  {
    name: "Sample sufficiency",
    icon: SufficiencyIcon,
    art: "art-icon-sufficiency",
  },
];
---

<Section class="features">
  <H level="2">Cellbytes features</H>
  <p class="lead">
    Cellbytes delivers a comprehensive cytomorphological assessment, including
    whole-slide analysis, cell classification, and dysplasia detection. Every
    algorithm is built on high-quality data covering normal and pathological
    varieties, cutting-edge research and validated by robust scientific and
    clinical metrics. By trusting Cellbytes, you will receive an extensive data
    package.
  </p>

  <div class="sample-type">
    <H level="3">1. Bone marrow samples</H>
    <H level="4" class="label">Cell differentials and dysplasias</H>

    <CellClasses id="bm" lineages={BONE_MARROW}>
      <p class="panel-label">Dysplasia types</p>
      <Dysplasias groups={BM_DYSPLASIAS} />
    </CellClasses>

    <div class="assessments">
      <div>
        <H level="4" class="label">Morphology</H>
        <Glyphs items={MORPHOLOGY} />
      </div>
      <div>
        <H level="4" class="label">Sample-level</H>
        <Glyphs items={SAMPLE_LEVEL} />
      </div>
    </div>
  </div>

  <div class="sample-type">
    <H level="3">2. Peripheral blood samples</H>
    <H level="4" class="label">Cell differentials</H>

    <CellClasses id="pb" lineages={PERIPHERAL_BLOOD}>
      <p class="panel-label">Dysplasia types</p>
      <Dysplasias groups={PB_DYSPLASIAS} />
    </CellClasses>

    <div class="assessments">
      <div>
        <H level="4" class="label">Morphology</H>
        <Glyphs items={MORPHOLOGY} />
      </div>
    </div>
  </div>
</Section>

<style>
  .features {
    gap: calc(2 * var(--element-padding));
  }
  .lead {
    max-width: 60ch;
  }

  .sample-type {
    width: 100%;
    max-width: 64em;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
  }

  /* The sub-headings inside a sample type are labels over the block they
     introduce, in the brand magenta the design uses to separate them from the
     navy headings above. */
  .label {
    font-size: var(--text-size-body);
  }
  .label :global(a) {
    color: var(--logo-magenta);
  }

  /* Morphology and the sample-level measures sit side by side under the
     classes, each glyph over the name of what it measures. */
  .panel-label {
    color: var(--accent-2);
    font-weight: 600;
    margin-block-end: 0.5em;
  }

  .assessments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(2 * var(--element-padding));
    text-align: center;
  }
</style>
