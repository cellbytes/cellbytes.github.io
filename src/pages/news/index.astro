---
import BytesSmall from "~src/assets/backgrounds/bytes/cluster-mini.svg";
import CellsSmall from "~src/assets/backgrounds/cells/cluster-mini.svg";
import Layout from "~src/layouts/Layout.astro";
import microscope from "~src/assets/images/home/microscope.png";
import type { PageMeta } from "~src/utils/opengraph";
import Section from "~src/components/Section.astro";
import NewsCard from "~src/components/NewsCard.astro";
import { getNewsPosts } from "~src/utils/news";

const posts = await getNewsPosts();

export const meta = {
  title: "News | Cellbytes",
  description:
    "Updates from the Cellbytes team on the Cellbytes application, digital pathology and related research.",
  card: { title: "News from Cellbytes", image: microscope },
} satisfies PageMeta;
---

<Layout {...meta}>
  <Section>
    <CellsSmall class="cells breathe" />
    <div class="text">
      <h1>News from Cellbytes</h1>
      <p>
        Updates from the Cellbytes team on the Cellbytes application, digital
        pathology and related research.
      </p>
    </div>
    <BytesSmall class="art-bytes-cluster bytes blink" />
  </Section>

  <Section>
    <section class="posts" aria-label="News articles">
      {
        posts.map(({ post, accent }) => (
          <NewsCard post={post} accent={accent} />
        ))
      }
    </section>
  </Section>
</Layout>

<style>
  :global(body) {
    min-height: 100vh;
  }

  :global(main) {
    row-gap: calc(var(--block-padding) / 2) !important;
  }

  .cells {
    position: absolute;
    height: 100px;
    left: 0;
    top: 0;
  }

  .bytes {
    position: absolute;
    height: 100px;
    right: 0;
    bottom: 0;
  }

  /* The clusters collide with the heading on narrow screens */
  @media screen and (width < 50em) {
    .cells,
    .bytes {
      display: none;
    }
  }

  .posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
    width: 100%;
  }
</style>
