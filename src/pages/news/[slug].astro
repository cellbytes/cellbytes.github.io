---
import Layout from "~src/layouts/Layout.astro";
import LinkButton from "~src/components/LinkButton.astro";
import CallToAction from "~src/components/CallToAction.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { WIDTHS } from "~src/consts";
import { imageNeedsFrame } from "~src/utils/image";
import { postModifiedDate } from "~src/utils/news";
import { blogPosting, breadcrumbs } from "~src/utils/structuredData";
import { ogImagePath, ogSlug } from "~src/utils/opengraph";
import { canonicalUrl } from "~src/utils/url";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const hasImage = Boolean(post.data.image);
// A transparent or mostly white hero image blends into the light page, so frame
// it to keep a defined edge. See TextCard for the same guard.
const framed = post.data.image ? await imageNeedsFrame(post.data.image) : false;

const modified = postModifiedDate(post);

const article = {
  published: post.data.date,
  modified,
  author: post.data.author,
  tags: post.data.tags,
};

// Derived the same way `Layout` derives them, so the structured data can never
// name a different URL or a different card than the head does.
const postUrl = canonicalUrl(Astro.url.pathname, Astro.site);
const cardUrl = new URL(
  ogImagePath(ogSlug(Astro.url.pathname)),
  Astro.site ?? postUrl.origin,
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={`${post.data.title} | Cellbytes`}
  description={post.data.description}
  ogType="article"
  article={article}
  jsonLd={[
    blogPosting(article, {
      url: postUrl,
      title: post.data.title,
      description: post.data.description,
      image: cardUrl,
    }),
    breadcrumbs(new URL(Astro.site ?? postUrl.origin), [
      { name: "News", path: "/news" },
      { name: post.data.title, path: postUrl.pathname },
    ]),
  ]}
>
  <article>
    <div
      class:list={["post-hero", hasImage ? "image" : "gradient", { framed }]}
    >
      {
        post.data.image && (
          <Image
            src={post.data.image}
            alt={post.data.imageAlt ?? ""}
            widths={WIDTHS}
            loading="eager"
            class="hero-image"
          />
        )
      }
      <LinkButton variant="default-arrow-back" href="/news">
        News list
      </LinkButton>
      <h1>{post.data.title}</h1>
    </div>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.author && <span class="author">{post.data.author}</span>}
      </div>
      {
        post.data.tags && (
          <ul class="tag-list">
            {post.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <Content />
  </article>

  <CallToAction
    title="Ready to digitize your hematology laboratory?"
    topic="news"
  />
</Layout>

<style is:global>
  article,
  section:not(.call-to-action) {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 70ch;
    justify-self: center;

    color: var(--text-color-body);
    font-size: var(--text-size-body);
  }

  article * + h2,
  article * + h3,
  section.footnotes > h2 {
    margin-top: 1rem;
  }

  article h2,
  article h3,
  article h4 {
    text-align: start;
  }

  article > ul,
  article > ol,
  section > ul,
  section > ol {
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  article hr {
    width: 50%;
    margin-block: 2em;
  }

  /* An image in the prose, captioned (`![alt](./photo.jpg "caption")`) or not.
     The reset gives every image `object-fit: cover`, which crops one whose box
     is not its own shape; a picture in a post has to be shown whole. */
  article :is(p, figure) > img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--small-border-radius);
  }

  /* Every figure in a post, whether `titleFigure` built it around an image or
     `PostVideo` wrote it around a recording: the caption sits directly under
     what it describes, and reads the same either way. */
  article figure {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  article figcaption {
    color: var(--text-color-body);
    text-align: center;
    font-size: var(--text-size-label);
    font-style: italic;
  }

  article sup + sup:before {
    content: ", ";
  }

  /* Offset footnote jump targets (both the definitions and the back-reference
     markers) so the sticky header does not cover them when clicked. */
  article [id^="user-content-fn"] {
    scroll-margin-top: 6rem;
  }

  article .footnotes a {
    word-break: break-all;
  }
</style>

<style>
  /* Hero */
  .post-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-radius: var(--element-border-radius);

    min-height: 26rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--element-padding);
    margin-inline: calc(0px - var(--element-padding));
  }

  /* Frame only light/transparent hero images so they stay defined against the
     light page. Detection matches TextCard (transparency or white edges). */
  .post-hero.framed {
    border: 2px solid var(--background-1);
  }

  /* h1 must sit above the image and scrim pseudo-element */
  .post-hero > * {
    position: relative;
    z-index: 1;
    text-align: start;
    max-width: 70ch;
  }

  .post-hero > .hero-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    background-color: var(--background);
  }

  /* Gradient variant (no image) */
  .gradient {
    background:
      radial-gradient(
        60% 80% at 85% 15%,
        var(--cells-dark-pink) 0%,
        transparent 100%
      ),
      radial-gradient(
        50% 70% at 15% 85%,
        var(--bytes-dark-blue) 0%,
        transparent 100%
      ),
      radial-gradient(
        45% 60% at 60% 70%,
        var(--support-purple) 0%,
        transparent 100%
      ),
      var(--background-1);
  }

  /* Dark gradient scrim so light text stays legible */
  .image::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(from var(--primary-1) r g b / 0.85) 0%,
      transparent 55%
    );
  }

  .image h1 {
    color: var(--background);
  }

  /* Post metadata (below hero) */
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: var(--text-color-body);
    font-size: var(--text-size-label);
  }

  time {
    font-style: italic;
  }

  .author::before {
    content: "\00b7";
    margin-right: 0.75rem;
  }

  .tag-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.2em 0.75em;
    border-radius: var(--button-border-radius);
    background-color: var(--support-purple);
    color: var(--text-color-heading);
    text-transform: capitalize;
  }

  /* smallest breakpoint -2*var(--element-padding) */
  @media screen and (width < 48em) {
    .post-hero {
      border-radius: 0px;
    }
  }

  @media screen and (width >= 70em) {
    :root {
      --text-size-heading-2: 2.5rem;
    }
  }
</style>
