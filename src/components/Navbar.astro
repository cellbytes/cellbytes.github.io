---
import LinkButton from "~src/components/LinkButton.astro";
import Logotype from "~src/assets/icons/logotype.svg";

const currentPath = Astro.url.pathname;

/**
 * A link with `children` is a disclosure rather than a destination: the parent
 * has no page of its own, so it renders as a button that reveals the group.
 */
const links = [
  { name: "Application", href: "/application" },
  {
    name: "Use-cases",
    children: [
      { name: "Clinical", href: "/use-cases/clinical" },
      { name: "Research", href: "/use-cases/research" },
    ],
  },
  { name: "Compliance", href: "/compliance" },
  { name: "Publications", href: "/publications" },
  // { name: "Documentation", href: "/documentation" },
  { name: "Company", href: "/company" },
  { name: "News", href: "/news" },
];

const subLinks = links.flatMap((link) => link.children ?? []);

/** Highlights the disclosure while the reader is on one of its pages. */
const inGroup = (children: { href: string }[]) =>
  children.some((child) => currentPath.startsWith(child.href));
---

<header style={`--links: ${links.length}; --sublinks: ${subLinks.length}`}>
  <div class="header-contents">
    <a href="/" class="logo-link" aria-label="Back to front page">
      <Logotype />
    </a>

    <button
      id="menuButton"
      aria-label="Show navigation menu"
      aria-expanded="false"
      aria-controls="navigation"
    >
      Menu

      <svg width="1.25em" height="1.25em" viewBox="0 0 24 24">
        <g id="menuOpenIcon">
          <path d="M3 12H21"></path>
          <path d="M3 6H21"></path>
          <path d="M3 18H21"></path>
        </g>
        <g id="menuCloseIcon">
          <path d="M18 6L6 18"></path>
          <path d="M6 6L18 18"></path>
        </g>
      </svg>
    </button>

    <nav id="navigation" aria-label="Main navigation">
      <ul role="list">
        {
          links.map((link) =>
            link.children ? (
              <li class="group">
                <button
                  class="group-button"
                  aria-expanded="false"
                  aria-current={inGroup(link.children) && "page"}
                >
                  {link.name}

                  <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden>
                    <path d="M6 9L12 15L18 9" />
                  </svg>
                </button>

                <ul role="list" class="group-links">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={
                          currentPath.startsWith(child.href) && "page"
                        }
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath.startsWith(link.href!) && "page"}
                >
                  {link.name}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <LinkButton class="demo-button" href="/contact" variant="highlight">
        Contact us
      </LinkButton>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("header")!;
  const navButton = document.getElementById("menuButton")!;
  const disclosure = document.getElementById("navigation")!;
  const listItems = disclosure.querySelectorAll("li a");

  function openNavigation() {
    navButton.setAttribute("aria-expanded", "true");
    header.classList.add("shadow");
  }

  function closeNavigation() {
    navButton.setAttribute("aria-expanded", "false");
    if (window.scrollY === 0) header.classList.remove("shadow");
  }

  function toggleNavigation() {
    const open = navButton.getAttribute("aria-expanded");
    open === "false" ? openNavigation() : closeNavigation();
  }

  navButton.addEventListener("click", toggleNavigation);

  // add event to the last item in the nav list to move focus back to the nav button
  listItems[listItems.length - 1]!.addEventListener("blur", () =>
    navButton.focus(),
  );

  const groupButtons =
    disclosure.querySelectorAll<HTMLButtonElement>(".group-button");

  function closeGroups(except?: Element) {
    for (const button of groupButtons) {
      if (button !== except) button.setAttribute("aria-expanded", "false");
    }
  }

  for (const button of groupButtons) {
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      closeGroups(button);
      button.setAttribute("aria-expanded", open ? "false" : "true");
    });
  }

  // A group left open covers the page below it, so anything that moves the
  // reader on - a click elsewhere, focus leaving the header - closes it.
  document.addEventListener("click", (e) => {
    if (!disclosure.contains(e.target as Node)) closeGroups();
  });
  disclosure.addEventListener("focusout", () => {
    // Focus lands on the new element only after this event, so read it late.
    requestAnimationFrame(() => {
      if (!disclosure.contains(document.activeElement)) closeGroups();
    });
  });

  // Close the disclosure if a user presses the escape key
  window.addEventListener("keyup", (e) => {
    if (e.key === "Escape") {
      navButton.focus();
      closeGroups();
      closeNavigation();
    }
  });
  window.addEventListener("scroll", () => {
    if (window.scrollY > 5) {
      header.classList.add("shadow");
    } else if (window.scrollY <= 5) {
      header.classList.remove("shadow");
    }
  });
  window.addEventListener("load", () => {
    if (window.scrollY > 5) {
      header.classList.add("shadow");
    }
  });
</script>

<style>
  a {
    color: var(--text-color-heading);
    text-decoration: none;
    font-weight: bold;
  }
  a[aria-current="page"],
  .group-button[aria-current="page"] {
    border-radius: var(--small-border-radius);
    background-color: var(--bytes-purple);
  }

  header {
    position: sticky;
    top: 0px;
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
    background: rgb(from var(--background) r g b / 0.3);
    -webkit-backdrop-filter: blur(25px);
    backdrop-filter: blur(25px);
    z-index: 999;
  }
  :global(.shadow) {
    transition: box-shadow 200ms ease-out;
    box-shadow: var(--shadow-sm);
  }
  .header-contents {
    grid-column: content;
    display: grid;
    grid-template-areas:
      "logo menu"
      "dropdown dropdown";
    grid-template-rows: 5rem auto;
    grid-template-columns: auto auto;
    align-items: center;
    justify-content: space-between;
  }
  .logo-link {
    grid-area: logo;
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-size-link);
    padding-block: 0.5rem;
  }

  :global(.logo-link > svg) {
    height: 40px;
    width: auto;
  }

  /* Nav links */
  nav {
    grid-area: menu;
    display: flex;
    align-items: center;
    gap: 2em;
  }
  ul {
    display: flex;
    gap: 0.5em;
    list-style: none;
  }
  li {
    position: relative;
  }
  li > a {
    display: block;
    padding: 0.5em 1em;
  }
  li > a:hover {
    text-decoration: underline;
  }

  /* Use-cases group */
  .group-button {
    display: flex;
    align-items: center;
    gap: 0.25em;

    font: inherit;
    font-weight: bold;
    color: var(--text-color-heading);

    padding: 0.5em 1em;
    border: none;
    background: none;
    cursor: pointer;
  }
  .group-button:hover {
    text-decoration: underline;
  }
  .group-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate 150ms ease-out;
  }
  .group-button[aria-expanded="true"] svg {
    rotate: 180deg;
  }
  .group-button[aria-expanded="false"] + .group-links {
    display: none;
  }

  #menuButton {
    grid-area: menu;
    display: flex;
    align-items: center;
    justify-self: flex-end;
    gap: 0.5em;

    font-weight: 600;
    font-size: var(--text-size-label);
    color: var(--text-color-heading);

    padding: 0.75rem 1.25rem 0.75rem 1.5rem;
    border-radius: var(--button-border-radius);
    border: 1px solid var(--primary-1);
    background-color: transparent;

    cursor: pointer;
  }
  #menuButton svg {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  button[aria-expanded="true"] #menuOpenIcon {
    display: none;
  }
  button[aria-expanded="false"] #menuCloseIcon {
    display: none;
  }
  @media screen and (width >= 70em) {
    #menuButton {
      display: none;
    }
    /* The group hangs over the page rather than displacing the header. */
    .group-links {
      position: absolute;
      top: 100%;
      left: 0;
      flex-direction: column;
      gap: 0.25em;
      min-width: max-content;
      padding: 0.5em;
      border-radius: var(--small-border-radius);
      background-color: var(--background);
      box-shadow: var(--shadow-sm);
    }
  }
  @media screen and (width < 70em) {
    /* The open menu overlays the page instead of pushing it down, so the
       header pulls back the height its own rows added. An open group adds
       its links to that count. */
    header:has(#menuButton[aria-expanded="true"]) {
      padding-block-end: 2rem;
      margin-block-end: calc(var(--links) * -3rem - 1.5rem);
    }
    header:has(#menuButton[aria-expanded="true"]):has(
        .group-button[aria-expanded="true"]
      ) {
      margin-block-end: calc((var(--links) + var(--sublinks)) * -3rem - 1.5rem);
    }
    #menuButton[aria-expanded="false"] + nav {
      display: none;
    }
    .group-links {
      padding-inline-start: 1em;
    }
    nav {
      grid-area: dropdown;
      justify-content: space-between;
    }
    ul {
      flex-direction: column;
      list-style-position: inside;
      gap: 0.5em;
    }
    li > a {
      display: inline-block;
    }
    .demo-button {
      align-self: flex-end;
    }
  }
</style>
