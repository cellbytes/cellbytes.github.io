---
import { getImage, Image } from "astro:assets";
import collaborating from "~src/assets/images/mockups/collaborating_erythroblasts.webp";
import commenting from "~src/assets/images/mockups/comment-function.webp";
import laptop from "~src/assets/images/home/laptop-on-desk.png";
import evidentVs200 from "~src/assets/images/home/evident-vs200.webp";
import pramanaHt from "~src/assets/images/home/pramana-ht.webp";
import evidentLogo from "~src/assets/images/home/evident-logo.jpg";
import Logotype from "~src/assets/icons/logotype.svg";
import microscope from "~src/assets/images/home/microscope.png";
import bannerPoster from "~src/assets/images/home/banner-poster.jpeg";
import BytesEdge from "~src/assets/backgrounds/bytes/in-element-edge.svg";
import HusLogo from "~src/assets/icons/partners/hus.svg";
import FimlabLogo from "~src/assets/icons/partners/fimlab.svg";
import VarhaLogo from "~src/assets/icons/partners/varha.svg";

import { WIDTHS } from "~src/consts";
import ContentBlock from "~src/components/ContentBlock.astro";
import Section from "~src/components/Section.astro";
import Pair from "~src/components/Pair.astro";
import DecoratedCard from "~src/components/DecoratedCard.astro";
import CellsSection from "~src/components/CellsSection.astro";
import CellsEdgeSection from "~src/components/CellsEdgeSection.astro";
import CallToAction from "~src/components/CallToAction.astro";
import { contactHref } from "~src/utils/contactTopics";
import H from "~src/components/HeadingLink.astro";
import LinkButton from "~src/components/LinkButton.astro";
import ApplicationFrame from "~src/components/ApplicationFrame.astro";
import Layout from "~src/layouts/Layout.astro";
import type { PageMeta } from "~src/utils/opengraph";
import BytesSection from "~src/components/BytesSection.astro";
import HeroSection from "~src/components/HeroSection.astro";
import NewsHighlights from "~src/components/NewsHighlights.astro";
import Faq from "~src/components/Faq.astro";

export const meta = {
  title: "Cellbytes",
  description:
    "AI solutions for hematopathologists, hematologists and researchers.",
  card: { variant: "brand" },
} satisfies PageMeta;

// The hero video's poster is what the page paints first and holds until the
// stream has buffered, so it is the largest paint on the front page. Going
// through the image pipeline rather than sitting in `public/` is what gets it
// encoded and sized; served raw it was a 195 KB JPEG at full width.
const poster = await getImage({
  src: bannerPoster,
  format: "avif",
  width: 1200,
});
---

<Layout {...meta}>
  <!-- The browser finds a `poster` only once it reaches the video element,
    which is late for the element that decides the page's largest paint. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={poster.src}
    fetchpriority="high"
  />

  <HeroSection class="hero">
    <div class="hero-content">
      <h1>Cellbytes &ndash; precision hematology with digital microscopy</h1>
      <ApplicationFrame class="hero-videos">
        <video
          width="1200"
          autoplay
          muted
          loop
          playsinline
          aria-label="Demonstration of Cellbytes’s features"
          poster={poster.src}
          data-hls-src="/banner/master.m3u8"
          id="demo-video"
        >
        </video>
        <video
          width="1200"
          controls
          playsinline
          preload="none"
          aria-label="Introduction to Cellbytes"
          data-hls-src="/intro/master.m3u8"
          id="intro-video"
          class="inactive"
        >
        </video>
      </ApplicationFrame>
      <LinkButton
        class="video-toggle"
        aria-controls="demo-video intro-video"
        data-video-toggle
      >
        Show me more
      </LinkButton>
    </div>
  </HeroSection>

  <Section>
    <H level="2">The future is now</H>
    <p class="ingress">
      Cellbytes is the new standard in hematopathology. By integrating the
      entire cytomorphological analysis for both bone marrow and peripheral
      blood smears in one software, it’s easier than ever to modernize your
      diagnostic workflows.
    </p>
  </Section>

  <CellsSection>
    <Pair>
      <Image
        src={collaborating}
        alt="Two doctors analyzing the results of a slide using Cellbytes."
        widths={WIDTHS}
        height="300"
      />
      <ContentBlock>
        <H level="2">Objective and transparent</H>
        <p>
          Cellbytes is a digital hematology system designed to augment
          hematopathologists, not replace them. Standardized, real-time digital
          assessment can enhance human performance and decrease subjectivity.
          Trained on millions of cells across diverse hematologic conditions,
          Cellbytes provides consistent, high-quality outputs. Every model
          prediction comes with clear visualizations and quantifiable data,
          ensuring transparency and supporting users to review what the software
          has identified.
        </p>
        <LinkButton href="/application" variant="default-arrow">
          Application details
        </LinkButton>
      </ContentBlock>
    </Pair>

    <Pair reversed>
      <Image
        src={commenting}
        alt="Doctor leaving a comment on an interesting slide region using Cellbytes."
        widths={WIDTHS}
        height="300"
      />
      <ContentBlock>
        <H level="2">Real-time analysis</H>
        <p>
          Cellbytes is an automated digital morphology analyzer designed for
          high-throughput, parallelized batch analysis serving both small and
          large laboratories ensuring diagnostics will keep pace with your
          clinical need. The secure cloud-based computing is available wherever
          you are and 24/7. You can also retrieve historical slides in seconds
          to effortlessly track patient progression over time.
        </p>
        <LinkButton
          href="/application#comprehensive-ai-powered-analysis"
          variant="default-arrow"
        >
          Analysis/evaluation workflow
        </LinkButton>
      </ContentBlock>
    </Pair>
  </CellsSection>

  <Pair tag="section">
    <div class="scanners">
      <figure>
        <Image
          src={evidentVs200}
          alt="Evident’s SLIDEVIEW VS200 slide scanner."
          widths={[300, 600]}
          height="300"
        />
        <figcaption>
          <a
            href="https://evidentscientific.com/en/products/slide-scanners/vs200"
          >
            Evident SLIDEVIEW VS200
          </a>
        </figcaption>
      </figure>

      <figure>
        <Image
          src={pramanaHt}
          alt="A Pramana HT Series scanner with its robotic slide loader."
          widths={[300, 600]}
          height="300"
        />
        <figcaption>
          <a
            href="https://evidentscientific.com/en/products/slide-scanners/pramana-ht"
          >
            Pramana HT Series
          </a>
        </figcaption>
      </figure>

      <a href="/news/cellbytes-and-evident-case-study" class="lockup">
        <Image
          src={evidentLogo}
          alt="Evident"
          widths={[240, 480]}
          height="60"
        />
        <span aria-hidden="true">&times;</span>
        <Logotype />
        <span class="visually-hidden">
          Cellbytes and Evident: read the case study
        </span>
      </a>
    </div>
    <ContentBlock>
      <H level="2">
        Precision software optimized with industry-leading imaging
      </H>
      <p>
        Out of all the supported scanners, the <a
          href="https://evidentscientific.com/en/products/slide-scanners/vs200"
        >
          Evident SLIDEVIEW VS200
        </a> and <a
          href="https://evidentscientific.com/en/products/slide-scanners/pramana-ht"
        >
          Pramana HT Series
        </a> are perfect matches for Cellbytes. Partnering with industry leading image
        quality and automated imaging enables you to focus on what matters most.
      </p>
      <p>
        Our digital hematology platform also natively supports most major
        microscopes and scanners with output images in DZI, SVS, VSI, CZI, MRXS,
        DICOM, and OME-TIFF formats. <a href={contactHref("scanner")}>
          Contact our team
        </a> today to verify compatibility with your institution’s specific imaging
        system.
      </p>
    </ContentBlock>
  </Pair>

  <BytesSection class="tall">
    <BytesEdge class="art-bytes-in-element-edge bytes-edge" />
    <div class="tall-image">
      <Image
        src={microscope}
        alt="Close-up of a microscope scanning a hematopathological slide."
        widths={WIDTHS}
        height="800"
      />
    </div>
    <ContentBlock class="tall-text">
      <H level="2">Flexible workflow integration</H>
      <p>
        We built Cellbytes for healthcare professionals, the pharmaceutical
        industry, and academic researchers who need clearer insights from visual
        data. It combines the accuracy required for routine diagnostics, the
        versatility of consultation and collaboration, as well as the
        flexibility needed to discover new biological insights. Especially
        clinical workflow may not always be the most robust, but with our remote
        hematology review software, collaboration both within and out of your
        facility becomes easier.
      </p>
      <LinkButton
        href="/use-cases/clinical#collaboration"
        variant="default-arrow"
      >
        Clinical workflow
      </LinkButton>
    </ContentBlock>
    <ContentBlock class="tall-text">
      <H level="2">Safe and secure</H>
      <p>
        We are committed to data security. By strictly adhering to international
        standards and data privacy regulations (HIPAA, GDPR), we can guarantee
        users to retain complete control over their data.
      </p>
      <LinkButton href="/compliance" variant="default-arrow">
        Security
      </LinkButton>
    </ContentBlock>
  </BytesSection>

  <DecoratedCard variant="bytes" tag="section">
    <H level="2">Full AI-assisted morphology analysis</H>
    <p class="ingress">
      Hematopathology is not just about counting cells. <a
        href="/application#cellbytes-features"
      >
        Cellbytes performs end-to-end cytomorphological assessment
      </a> covering cellularity, sample adequacy, megakaryocyte counts, cell classification,
      and dysplasia detection. Results are summarized in a standardized report that
      can be seamlessly integrated into your laboratory information system.
    </p>
  </DecoratedCard>

  <CellsEdgeSection class="use-cases">
    <div class="use-cases-photo">
      <Image
        src={laptop}
        alt="A laptop on a desk showing a cell gallery in Cellbytes."
        widths={WIDTHS}
        height="800"
      />
    </div>

    <ContentBlock class="use-cases-text">
      <H level="2">From cell images to clinical decisions</H>
      <p>
        An automatic cell differential is one thing. But a software to support
        every step of cytomorphological assessment is another. Cellbytes is
        there to elevate your diagnostic work and create new opportunities from
        remote work, consultation and even collaboration across clinical
        laboratories.
      </p>
      <LinkButton href="/use-cases/clinical" variant="default-arrow">
        Clinical use-cases
      </LinkButton>
    </ContentBlock>

    <ContentBlock class="use-cases-text">
      <H level="2">Quantitative morphometry</H>
      <p>
        Cellbytes was created by researchers for researchers. Analyzing cell
        morphology requires strong domain knowledge spanning both hematology and
        hematopathology. Cellbytes democratizes this process by providing
        researchers and pharmaceutical teams with a certified platform to turn
        high-dimensional single-cell morphology into disease biomarkers and
        accelerate drug discovery.
      </p>
      <LinkButton href="/use-cases/research" variant="default-arrow">
        Research use-cases
      </LinkButton>
    </ContentBlock>
  </CellsEdgeSection>

  <NewsHighlights />

  <Faq />

  <DecoratedCard variant="cells-bytes" tag="section" class="partnerships">
    <H level="2">In research partnership with</H>
    <ul>
      <li>
        <a href="https://www.hus.fi/en">
          <HusLogo aria-label="HUS logo" />
        </a>
      </li>
      <li>
        <a href="https://fimlab.fi/en/frontpage-eng/">
          <FimlabLogo aria-label="Fimlab logo" />
        </a>
      </li>
      <li>
        <a href="https://www.varha.fi/en">
          <VarhaLogo aria-label="Varha logo" />
        </a>
      </li>
    </ul>
  </DecoratedCard>

  <CallToAction
    title="Ready to digitize your cell morphology analysis?"
    topic="morphology"
  />
</Layout>

<script>
  // @ts-expect-error - hls.js light build ships without its own type declarations; runtime API matches the main export
  import Hls from "hls.js/light";

  /** The rendition playback starts on, before throughput has been measured. */
  const START_HEIGHT = 720;

  /**
   * Points a video at its `data-hls-src` stream, through hls.js wherever the
   * browser supports it and natively otherwise.
   *
   * hls.js comes first because it is the only player that can be told where
   * to start: Chrome's native HLS opens on the lowest tier and Safari's on the
   * first one listed, which is why the playlists list 720p first for the
   * players that still play natively.
   */
  const load = (video: HTMLVideoElement) => {
    const src = video.dataset.hlsSrc!;
    if (Hls.isSupported()) {
      const hls = new Hls();
      hls.on(Hls.Events.MANIFEST_PARSED, () => {
        const start = hls.levels.findIndex(
          (level: { height: number }) => level.height === START_HEIGHT,
        );
        if (start !== -1) hls.startLevel = start;
      });
      hls.loadSource(src);
      hls.attachMedia(video);
    } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
      video.src = src;
    }
    // No HLS support: the poster image stays visible (no further fallback).
  };

  /** Resolves once the video has put a frame on screen after `play()`. */
  const firstFrame = (video: HTMLVideoElement) =>
    new Promise<void>((resolve) => {
      // Not in Firefox before 132; `playing` can fire a frame early there.
      if (typeof video.requestVideoFrameCallback === "function") {
        video.requestVideoFrameCallback(() => resolve());
      } else {
        video.addEventListener("playing", () => resolve(), { once: true });
      }
    });

  const demo = document.querySelector<HTMLVideoElement>("#demo-video");
  const intro = document.querySelector<HTMLVideoElement>("#intro-video");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-video-toggle]",
  );

  if (demo && intro && toggle) {
    load(demo);
    let introLoaded = false;
    let wanted = demo;

    // Both videos stay attached and the hidden one is only paused, so a swap
    // never empties an element: the incoming video is revealed once it has a
    // frame to show, and the outgoing one keeps its frame until then. The
    // intro is narrated, so it plays once with sound and controls, and only
    // ever starts from this click, which is what lets it play unmuted.
    toggle.addEventListener("click", () => {
      const showIntro = intro.classList.contains("inactive");
      const [incoming, outgoing] = showIntro ? [intro, demo] : [demo, intro];
      if (showIntro && !introLoaded) {
        load(intro);
        introLoaded = true;
      }
      toggle.textContent = showIntro ? "Back to the demo" : "Show me more";
      wanted = incoming;
      void firstFrame(incoming).then(() => {
        // A later click has already asked for the other video.
        if (wanted !== incoming) return;
        incoming.classList.remove("inactive");
        outgoing.classList.add("inactive");
        outgoing.pause();
      });
      incoming.play().catch(() => {});
    });
  }
</script>

<style>
  /* Both use cases point at one photo rather than each carrying its own, so it
     spans their two rows and is cropped to whatever height they come to,
     reaching from the middle of the page out past the edge of the window. */
  .use-cases {
    align-items: center;
    column-gap: calc(2 * var(--element-padding));
    row-gap: calc(2 * var(--element-padding));
  }
  .use-cases-text {
    grid-column: content-start / content-mid;
  }
  .use-cases-photo {
    grid-column: content-mid / full-end;
    grid-row: 1 / span 2;
    align-self: stretch;
  }
  .use-cases-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--element-border-radius) 0 0 var(--element-border-radius);
  }

  @media screen and (width < 50em) {
    .use-cases-photo {
      grid-column: full;
      grid-row: auto;
    }
    .use-cases-photo :global(img) {
      border-radius: 0;
      max-height: 60vh;
    }
    .use-cases-text {
      grid-column: content;
    }
  }

  .hero {
    --gap: -100px;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    text-align: center;
    margin-block-end: var(--element-padding);
    max-width: 30ch;
  }

  p {
    font-size: var(--text-size-body);
  }

  /* Both videos share one grid cell, and the inactive one sits invisibly
     over the active one rather than being hidden, so that it keeps rendering
     and is ready to be swapped in on the frame it is revealed. Both are 16:9,
     so the swap never changes the frame's shape. The frame gets a definite
     width because it is a shrink-to-fit flex item: sized by its videos, it
     would change size as each loads its poster and then its stream. */
  .hero-videos {
    display: grid;
    width: 100%;
  }
  .hero-videos video {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .hero-videos video.inactive {
    opacity: 0;
    pointer-events: none;
  }

  .video-toggle {
    margin-block-start: var(--element-padding);
  }

  .ingress {
    font-size: var(--text-size-ingress);
    max-width: 60ch;
  }

  /* Two instruments over the mark that pairs the companies, which is what the
     section is about: the scanners Cellbytes is tuned for, and the partnership
     that tuned it. */
  .scanners {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-block: auto;
    gap: var(--element-padding);
    align-items: center;
  }
  .scanners figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  /* The two are photographed at different scales and one is far taller than the
     other, so they are given a shared box to sit in rather than a shared width,
     which would leave them looking like instruments of very different sizes. */
  .scanners figure :global(img) {
    inline-size: 100%;
    block-size: 14rem;
    object-fit: contain;
  }
  figcaption {
    color: var(--text-color-heading);
    text-align: center;
  }

  .lockup {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75em;
    color: var(--text-color-heading);
    font-size: var(--text-size-heading-3);
    text-decoration: none;
  }
  /* The wordmark is supplied with generous space above and below it, so its box
     has to stand taller than the logotype beside it for the two marks to read
     at the same size. */
  .lockup :global(img) {
    inline-size: auto;
    block-size: 3.4rem;
    object-fit: contain;
  }
  .lockup :global(svg) {
    inline-size: auto;
    block-size: 2.2rem;
  }

  .tall {
    grid-column: full;
    grid-template-columns: subgrid;
    align-items: center;
    column-gap: calc(2 * var(--element-padding));
  }

  .tall-image {
    grid-column: full-start / content-mid;
    grid-row: 1 / span 2;
    align-self: stretch;
  }
  .tall-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0 var(--element-border-radius) var(--element-border-radius) 0;
  }

  .tall-text {
    grid-column: content-mid / content-end;
  }

  .bytes-edge {
    position: absolute;
    top: -10%;
    bottom: -10%;
    right: -10%;
    height: 120%;
  }

  @media screen and (width < 50em) {
    .tall-image {
      grid-column: full;
    }
    .tall-image :global(img) {
      border-radius: 0;
      max-height: 60vh;
    }
    .tall-text {
      grid-column: content;
    }
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    flex-wrap: wrap;
    gap: calc(2 * var(--element-padding));
  }
  li {
    width: 150px;
  }

  .partnerships {
    padding-inline: calc(4 * var(--element-padding));
    padding-block: var(--element-padding);
    margin-block-end: var(--block-padding);
  }
</style>
