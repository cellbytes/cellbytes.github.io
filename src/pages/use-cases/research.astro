---
import { Image } from "astro:assets";
import research from "~src/assets/images/useCases/research.png";
import ShapeIcon from "~src/assets/icons/assessments/shape.svg";
import SizeIcon from "~src/assets/icons/assessments/size.svg";

import { WIDTHS } from "~src/consts";
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import Layout from "~src/layouts/Layout.astro";
import type { PageMeta } from "~src/utils/opengraph";
import Card from "~src/components/Card.astro";
import CellsSection from "~src/components/CellsSection.astro";
import ContentBlock from "~src/components/ContentBlock.astro";
import DecoratedCard from "~src/components/DecoratedCard.astro";
import BytesSection from "~src/components/BytesSection.astro";
import FormatFlow from "~src/components/FormatFlow.astro";
import HeroSection from "~src/components/HeroSection.astro";
import LinkButton from "~src/components/LinkButton.astro";
import Pair from "~src/components/Pair.astro";
import PublicationCard from "~src/components/PublicationCard.astro";
import { PUBLICATIONS } from "~src/utils/publications";

export const meta = {
  title: "Research | Cellbytes",
  description:
    "Cytomorphology data for research: morphology measurements, cell-level exports in the formats your analysis expects, and packages that scale from a proof of concept to a full cohort.",
  card: { title: "Cellbytes for research", image: research },
} satisfies PageMeta;

/** What an industrial licence costs against the academic rate for the same work. */
const INDUSTRIAL_RATE = 1.5;

/** Thousands are spaced rather than grouped with a comma, as the design sets them. */
const amount = (euros: number) =>
  String(euros).replace(/\B(?=(\d{3})+(?!\d))/g, " ");

/**
 * Core is sold by volume, so its price is a step on this scale rather than one
 * figure. The largest step is what the card shows until a choice is made,
 * which keeps the three cards reading smallest to largest at rest.
 */
const CORE_STEPS = [
  { slides: 200, academic: 6500 },
  { slides: 400, academic: 7500 },
  { slides: 600, academic: 8000 },
  { slides: 800, academic: 9000 },
  { slides: 1000, academic: 10000 },
];

/**
 * The packages, smallest first. Prices are per package rather than per slide,
 * which is what separates these from the clinical license. `academic` is the
 * academic rate and null where the package is quoted rather than priced;
 * `limit` is the slide ceiling, null where there is none.
 */
const PACKAGES = [
  {
    name: "Light",
    blurb: "Simple and concise analysis of a small batch of samples.",
    academic: 5000,
    limit: 100,
    steps: null,
    includes: [
      "1 Tb image storage for 1 year",
      "Sample and image analysis viewing",
      "Data exports at sample-level and cell-level",
    ],
  },
  {
    name: "Core",
    blurb: "A sizable set of samples to analyze in one go.",
    academic: null,
    limit: null,
    steps: CORE_STEPS,
    includes: [
      "10 Tb image storage for 1 year",
      "Sample and image analysis viewing",
      "Data exports at sample-level and cell-level",
      "Possibility to finetune models",
    ],
  },
  {
    name: "Advanced",
    blurb: "Expanding beyond routine sample analysis for bigger cohorts.",
    academic: null,
    limit: null,
    steps: null,
    includes: [
      "Image storage for 1 year",
      "Sample and image analysis viewing",
      "Data exports at sample-level and cell-level",
      "Possibility to finetune models",
      "3 hours of direct support from a Cellbytes data analyst for preprocessing and analytical guidance",
    ],
  },
];

// The two most recent papers, so this page stays a pointer to /publications
// rather than a second copy of the list.
const latest = PUBLICATIONS.slice(0, 2);
---

<Layout {...meta}>
  <HeroSection>
    <Pair>
      <Image
        src={research}
        alt="A man looking at a pinboard filled with research papers."
        widths={WIDTHS}
        height="300"
      />
      <ContentBlock>
        <h1>Research</h1>
        <p>
          Cellbytes was founded by researchers with the passion to accelerate
          new discoveries using advanced computational tools. Cytomorphology may
          be a classic technique, but we believe to have barely surfaced its
          full potential. Imagine identifying novel morphological fingerprints
          of drug response, or uncovering how genetic alterations disrupt
          hematopoiesis and normal cell morphology. With Cellbytes, those
          answers are finally within reach.
        </p>
        <p>
          We&apos;re eager to collaborate and help you make new discoveries.
          Cellbytes&apos;s in-house R&D team has developed advanced algorithms
          for investigational use. Let us know how we can support your research
          work and push the boundaries of our understanding of hematopathology.
        </p>
      </ContentBlock>
    </Pair>
  </HeroSection>

  <DecoratedCard variant="bytes" tag="section">
    <H level="2">Morphology for research purposes</H>
    <p class="lead">
      Quantitative morphometry is a game changer for medical research. Cellbytes
      is a cytomorphology analysis platform that delivers precise measurements
      of cell and nuclear dimensions, capturing critical metrics on both size
      and structural geometry.
    </p>

    <ul class="glyphs">
      <li>
        <SizeIcon class="art-icon-size" />
        Size
      </li>
      <li>
        <ShapeIcon class="art-icon-shape" />
        Shape
      </li>
    </ul>
  </DecoratedCard>

  <BytesSection class="formats">
    <div class="formats-copy">
      <ContentBlock>
        <H level="2">Input formats</H>
        <p>
          Cellbytes supports whole-slide and single-cell image analysis across
          most major microscopes and digital scanners. The platform seamlessly
          processes diverse image formats. This allows laboratories to easily
          integrate the software into their existing hardware setups without
          needing complex installations or extra hardware.
        </p>
      </ContentBlock>
    </div>
    <FormatFlow />
    <div class="formats-copy trailing">
      <ContentBlock>
        <H level="2">Output formats</H>
        <p>
          Cellbytes makes it simple to export your image analysis results in
          various formats tailored for research and clinical studies. This
          allows your team to integrate hematology insights into deeper
          analysis.
        </p>
      </ContentBlock>
    </div>
  </BytesSection>

  <Section>
    <H level="2">Related publications</H>
    {latest.map((publication) => <PublicationCard publication={publication} />)}
    <LinkButton variant="default-arrow" href="/publications">
      All publications
    </LinkButton>
  </Section>

  <Section class="pricing">
    <H level="2">Pricing for research</H>
    <p class="lead">
      To support academic and industry projects of any scale, Cellbytes offers
      flexible packages, which can be tailored to your specific volume needs.
      Whether you are running a proof-of-concept study or a large-scale clinical
      trial, you can choose a plan that fits your exact image processing
      requirements ensuring clinical-grade and high-throughput AI analysis. We
      also offer cost-effective extensions to existing packages to ensure
      long-term data storage.
    </p>
  </Section>

  <CellsSection class="packages-band">
    <div class="audience-row">
      <div class="audience" role="group" aria-label="Show prices for">
        <button type="button" data-audience="academic" aria-pressed="true">
          Academic
        </button>
        <button type="button" data-audience="industrial" aria-pressed="false">
          Industrial
        </button>
      </div>
    </div>

    <div class="packages">
      {
        PACKAGES.map((tier) => (
          <Card class="package">
            <H level="3">{tier.name}</H>
            <p class="blurb">{tier.blurb}</p>
            {(() => {
              const top = tier.steps?.at(-1);
              const academic = tier.academic ?? top?.academic;
              const limit = tier.limit ?? top?.slides ?? null;
              return (
                <Fragment>
                  <p class="price">
                    {academic ? (
                      <Fragment>
                        <span
                          class="amount"
                          data-academic={amount(academic)}
                          data-industrial={amount(academic * INDUSTRIAL_RATE)}
                        >
                          {amount(academic)}
                        </span>{" "}
                        &euro;
                      </Fragment>
                    ) : (
                      "Custom"
                    )}
                  </p>
                  <LinkButton class="cta" href="/contact">
                    Contact us to order
                  </LinkButton>

                  <p class="includes">Includes:</p>
                  <p class="slides">
                    {tier.steps ? (
                      <Fragment>
                        up to{" "}
                        <label class="volume">
                          <span class="visually-hidden">Slides included</span>
                          <select>
                            {tier.steps.map((step) => (
                              <option
                                value={step.slides}
                                selected={step.slides === top?.slides}
                                data-academic={amount(step.academic)}
                                data-industrial={amount(
                                  step.academic * INDUSTRIAL_RATE,
                                )}
                              >
                                {amount(step.slides)} slides
                              </option>
                            ))}
                          </select>
                        </label>
                      </Fragment>
                    ) : limit === null ? (
                      <strong>No slide limits</strong>
                    ) : (
                      <Fragment>
                        up to <strong>{amount(limit)}</strong> slides
                      </Fragment>
                    )}
                  </p>
                </Fragment>
              );
            })()}
            <ul>
              {tier.includes.map((item) => (
                <li>
                  <svg
                    width="1.5em"
                    height="1.5em"
                    viewBox="0 0 16 16"
                    aria-hidden
                  >
                    <path d="M2.5 8.5L6 12L13.5 4" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>

    <div class="offer">
      <LinkButton variant="default-arrow" href="/contact">
        Request a custom offer
      </LinkButton>
    </div>
  </CellsSection>
</Layout>

<script>
  /**
   * Both controls only ever restate a figure the page already carries: each
   * price knows its own two rates, and each volume step knows what it costs. So
   * the page renders correct at the academic rate and the largest volume with no
   * script at all, and this only swaps which of the figures already present is
   * the one on show. The slide count needs no swapping of its own, since the
   * select showing it is what the reader changed.
   */
  const group = document.querySelector<HTMLElement>(".audience");
  const volume = document.querySelector<HTMLSelectElement>(".volume select");

  if (group) {
    const buttons = [...group.querySelectorAll("button")];
    const volumeCard = volume?.closest(".package") ?? null;
    let audience = "academic";

    const paint = () => {
      for (const el of document.querySelectorAll<HTMLElement>(
        ".price .amount",
      )) {
        // The volume card's rate lives on the chosen step, not on the figure.
        const source =
          volume && el.closest(".package") === volumeCard
            ? volume.selectedOptions[0]
            : el;
        const next = source?.dataset[audience];
        if (next) el.textContent = next;
      }
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        audience = button.dataset.audience ?? "academic";
        for (const other of buttons) {
          other.setAttribute(
            "aria-pressed",
            String(other.dataset.audience === audience),
          );
        }
        paint();
      });
    }

    volume?.addEventListener("change", paint);
  }
</script>

<style>
  /* Section copy sits in a measured column rather than running the full width
     of the page. */
  .lead {
    max-width: 60ch;
  }

  /* The diagram already carries its own whitespace, so it does not need the
     full row gap between it and the copy it belongs to. */
  .formats {
    row-gap: calc(2 * var(--element-padding));
  }

  /* The copy brackets the diagram: inputs above it and to the left, outputs
     below it and to the right, following the direction the flow runs. Both
     bands are capped at the diagram's own width so they line up with the ends
     of the arrows rather than with the page. Below the diagram's breakpoint
     there is no room to hold a column to one side, so they simply stack. */
  .formats-copy {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
  }
  .formats-copy :global(.content-block) {
    max-width: 27rem;
  }
  .formats-copy.trailing :global(.content-block) {
    margin-inline-start: auto;
  }

  /* The two glyphs are drawn at different aspect ratios, so a shared height
     rather than a shared width is what lines them up. */
  .glyphs {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: calc(2 * var(--element-padding));
    list-style: none;
    padding: 0;
  }
  .glyphs li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    color: var(--text-color-heading);
    font-weight: 600;
  }
  .glyphs :global(svg) {
    height: 4rem;
    width: auto;
  }

  /* CellsSection lays its children on the page grid, which stretches them to
     the content column. The card row wants that width; the action under it
     does not, so it sits in a block of its own that centers it. */
  .offer {
    display: flex;
    justify-content: center;
  }

  .packages-band {
    row-gap: var(--element-padding);
    margin-bottom: calc(-5rem - 2 * var(--element-padding));
  }

  .packages {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: var(--element-padding);
    width: 100%;
    z-index: 1;
  }

  /* Doubled class to beat Card's own .card { display: flex } rule: the prod
     build inlines some component styles after the page stylesheet, so equal
     specificity rules lose nondeterministically. */
  .package.package {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1em;
    flex: 20rem 1 0;
    max-width: 26rem;
    padding: calc(var(--element-padding));
    background-color: var(--background);

    /* A package sits flat on the band behind it, at the radius the rest of the
       page's blocks use rather than the tighter one Card defaults to. */
    border-radius: var(--element-border-radius);
    box-shadow: none;
  }

  /* Three across or one down, never the two-then-one that wrapping would give:
     the packages read as a scale, and a third card sitting alone under two
     others no longer reads as the last step of one. This is the width the row
     stops fitting at, so the column takes over exactly where wrapping began. */
  @media screen and (width < 70em) {
    .packages {
      flex-direction: column;
      align-items: center;
    }

    /* The basis above is a column width; down here the same value would be a
       height, holding every card open to 20rem whether or not it has the
       content to fill it. */
    .package.package {
      flex: 0 0 auto;
      width: 100%;
    }
  }

  .package :global(h3) {
    font-size: var(--text-size-heading-3);
  }
  .price {
    font-size: var(--text-size-heading-2);
    font-weight: bold;
    color: var(--text-color-heading);
    margin-block: 0.25em 0.5em;
  }

  .cta {
    justify-content: center;
  }

  /* CellsSection lays its children on the page grid, which stretches them to the
     content column, so the switch sits in a block of its own that centers it
     over the cards it governs. */
  .audience-row {
    display: flex;
    justify-content: center;
    z-index: 1;
  }

  /* One control rather than two buttons: the group is the pill, and the side in
     force is a second pill sitting inside it. */
  .audience {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: var(--button-border-radius);
    background-color: var(--accent-1);
  }
  .audience button {
    padding: 0.5em 1.25em;
    border: 0;
    border-radius: var(--button-border-radius);
    background-color: transparent;
    color: var(--background);
    font: inherit;
    font-size: var(--text-size-label);
    cursor: pointer;
  }
  .audience button[aria-pressed="true"] {
    background-color: var(--background);
    color: var(--text-color-heading);
    font-weight: 700;
  }

  /* Volume is the one thing a Core package is chosen on, so it sits with the
     action rather than down among the things every package includes. */
  /* The control reads as the number in the sentence rather than as a field
     under it, so it sits on the text baseline and is only as wide as the count
     it shows. */
  .volume {
    display: inline-block;
  }
  .volume select {
    padding: 0.45em 0.75em;
    border: 0;
    border-radius: var(--small-border-radius);
    background-color: var(--cells-dark-pink);
    color: var(--text-color-heading);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* Only one package is bought by volume, and the other two hold its row open so
     that what every package includes still starts on one line across the three. */
  /* Only one card carries a control on this line, and it is taller than the
     plain text the other two set there, so the line is held to one height and
     what every package includes still starts on the same row across the three. */
  .slides {
    display: flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: 2.5rem;
  }

  /* What a package holds is the part a reader compares across cards, so the
     lists start together rather than each one following its own blurb. */
  .includes {
    font-style: italic;
    padding-block-start: var(--element-padding);
  }

  /* Ticks rather than bullets: every line is something the package grants. */
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 1.25em auto;
    gap: 1em;
  }
  li + li {
    margin-block-start: 1em;
  }
  li svg {
    fill: none;
    stroke: var(--text-color-heading);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
