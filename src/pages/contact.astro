---
import { Image } from "astro:assets";
import papersCellsBytes from "~src/assets/images/contact/papers-cells-bytes.png";

import { WIDTHS } from "~src/consts";
import Layout from "~src/layouts/Layout.astro";
import type { PageMeta } from "~src/utils/opengraph";
import Input from "~src/components/Input.astro";
import Textarea from "~src/components/Textarea.astro";
import ContentBlock from "~src/components/ContentBlock.astro";
import HeroSection from "~src/components/HeroSection.astro";
import LinkButton from "~src/components/LinkButton.astro";
import Pair from "~src/components/Pair.astro";

const url = Astro.url;

export const meta = {
  title: "Contact | Cellbytes",
  description:
    "Questions about Cellbytes for clinical diagnostics, research or a proof-of-concept? Our experts are ready to help.",
  card: { title: "Contact us", image: papersCellsBytes },
} satisfies PageMeta;
---

<Layout {...meta}>
  <HeroSection>
    <Pair>
      <Image
        src={papersCellsBytes}
        alt="A doctor typing on her laptop with a stethoscope hanging around her neck."
        widths={WIDTHS}
        height="300"
      />
      <ContentBlock>
        <h1>Contact us</h1>
        <p>
          Do you have questions about our company or Cellbytes’s image analysis
          solutions? Whether you’re considering Cellbytes for clinical
          diagnostics, research, or a proof-of-concept &ndash; we’re ready to
          help. Fill out the form, and one of our experts will reach out to you
          shortly.
        </p>
        <form action="https://api.staticforms.xyz/submit" method="post">
          <input
            type="hidden"
            name="accessKey"
            value="da6aad0a-f620-4a72-8e1b-13dada412f45"
          />
          <input type="hidden" name="redirectTo" value={`${url}?success`} />
          <Input label="Name" name="name" required />
          <Input
            label="Email"
            name="email"
            type="email"
            inputmode="email"
            required
          />
          <Input label="Title" name="title" />
          <Input label="Institution" name="institution" />
          <Textarea label="Message" name="message" required />
          <LinkButton variant="highlight" class="submit">Submit</LinkButton>
        </form>
      </ContentBlock>
    </Pair>
  </HeroSection>
</Layout>

<script>
  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());
  if ("success" in params) {
    document.querySelector("title")!.innerHTML =
      "Thank you for contacting us! | Cellbytes";
    const element = document.createElement("p");
    element.innerHTML =
      "Thank you for contacting us! We will reach back to you shortly.";
    element.classList.add("note");
    const form = document.querySelector("form")!;
    form.parentElement!.insertBefore(element, form);
  }
</script>

<style>
  :global(html) {
    height: 100%;
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: calc(0.75 * var(--element-padding));
    justify-items: flex-start;
  }
  :global(div:has(> input)) {
    flex: 1 0 40%;
  }
  :global(div:has(> textarea)) {
    min-width: 100%;
  }

  .submit {
    align-self: flex-start;
  }

  :global(.note) {
    font-weight: 600;
    padding: var(--element-padding);
    border-radius: var(--small-border-radius);
    background-color: var(--background);
    border-left: 8px solid var(--highlight);
  }
</style>
