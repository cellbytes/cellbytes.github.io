---
import { Image } from "astro:assets";
import base from "~src/assets/images/applicationScroller/01-base.png";
import triage from "~src/assets/images/applicationScroller/02-triage.png";
import tutorialRois from "~src/assets/images/applicationScroller/03-tutorialization-rois.png";
import tutorialCells from "~src/assets/images/applicationScroller/04-tutorialization-cells.png";
import slideViewer from "~src/assets/images/applicationScroller/05-slide-viewer.png";
import scarcityCellularity from "~src/assets/images/applicationScroller/06-scarcity-cellularity.png";
import maskVisualization from "~src/assets/images/applicationScroller/07-mask-visualization.png";
import cellDifferential from "~src/assets/images/applicationScroller/08-cell-differential.png";
import fullDifferential from "~src/assets/images/applicationScroller/09-full-differential.png";
import cellList from "~src/assets/images/applicationScroller/10-cell-list.png";
import cellClusters from "~src/assets/images/applicationScroller/11-cell-clusters.png";
import dysplasias from "~src/assets/images/applicationScroller/12-dysplasias.png";
import report from "~src/assets/images/applicationScroller/13-report.png";

import { WIDTHS as W } from "~src/consts";
import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import Card from "~src/components/Card.astro";
import ApplicationFrame from "~src/components/ApplicationFrame.astro";
import ContentBlock from "~src/components/ContentBlock.astro";

// The base screenshot is always visible; each slide fades its screenshot
// in over it and gets a text card next to (desktop) or below (narrow) the
// application frame.
const baseImage = base;

const slides = [
  {
    name: "triage",
    image: triage,
    cardTitle: "Intelligent triage",
    cardBody:
      "Our system ranks bone marrow and peripheral blood samples by clinical urgency. By scoring cytomorphological features automatically, we ensure high-priority cases receive immediate attention.",
    position: "right",
  },
  {
    name: "tutorial-rois",
    image: tutorialRois,
    cardTitle: "Guided diagnostic workflow",
    cardBody:
      "Our system facilitates rapid adoption through step-by-step instructions and an intuitive introduction to the interface.",
    position: "right",
  },
  {
    name: "tutorial-cells",
    image: tutorialCells,
    cardTitle: "Guided diagnostic workflow",
    cardBody:
      "The evaluation flow will guide you through a sequence of analyses covering whole-sample analysis, selection of regions of interest, cell differential, cell cluster detection, dysplasia assessment and finally approving a standardized sample report.",
    position: "left",
  },
  {
    name: "slide-viewer",
    image: slideViewer,
    cardTitle: "Advanced interface for expert control",
    cardBody:
      "For experienced users, the advanced interface provides access to the full sample, offering total flexibility to conduct deep-dive analyses tailored to each case.",
    position: "right",
  },
  {
    name: "scarcity-cellularity",
    image: scarcityCellularity,
    cardTitle: "Comprehensive sample assessment",
    cardBody:
      "The system evaluates sample sufficiency, cellularity estimates to assess the density of hematopoietic cells and megakaryocyte density, all of which are integral parts of a comprehensive cytomorphological analysis.",
    position: "right",
  },
  {
    name: "mask-visualization",
    image: maskVisualization,
    cardTitle: "Visual verification",
    cardBody:
      "Validate preclassification results with precision using diagnostic masks. Overlays highlight the exact regions factored into the analysis, providing full transparency into the system’s identification process.",
    position: "left",
  },
  {
    name: "cell-differential",
    image: cellDifferential,
    cardTitle: "Innovative cell differential",
    cardBody:
      "Cellbytes combines a powerful in-house foundation model trained with millions of cells and medical context to preclassify every cell identified within the sample. For targeted analysis, users can define specific regions of interest to maximize clinical accuracy.",
    position: "right",
  },
  {
    name: "full-differential",
    image: fullDifferential,
    cardTitle: "Per-ROI detailed view",
    cardBody:
      "For a deeper dive, Cellbytes provides a detailed breakdown of results on a region-by-region basis to precisely compare different areas within the sample.",
    position: "right",
  },
  {
    name: "cell-list",
    image: cellList,
    cardTitle: "Interactive cell gallery",
    cardBody:
      "Review automated classifications with ease. Our organized cell-by-cell list allows users to validate the system’s performance and maintain full diagnostic control by updating labels on the fly. Cellbytes ensures rapid correction and validation using an intelligent cell similarity measure. These updated labels can also be used for model retraining, ensuring your system continuously adapts and performs best with your specific data.",
    position: "right",
  },
  {
    name: "cell-clusters",
    image: cellClusters,
    cardTitle: "Cell clusters",
    cardBody:
      "Focal patterns make residual disease easy to miss. Cellbytes highlights abnormal clusters of blasts, lymphocytes, and plasma cells to streamline MRD assessment for acute leukemia, improve lymphoma cell detection, and accurately measure plasma cell dyscrasias.",
    position: "right",
  },
  {
    name: "dysplasias",
    image: dysplasias,
    cardTitle: "Lineage-specific dysplasia analysis",
    cardBody:
      "A first in automated cytomorphology: detect and characterize dysplastic cells across multiple lineages rapidly and securely.",
    position: "right",
  },
  {
    name: "report",
    image: report,
    cardTitle: "Seamless reporting",
    cardBody:
      "Finalize your evaluation with a single click. Approve the generated results and sign off on the sample to complete the digital workflow and archive the report.",
    position: "left",
  },
];

// All animations run on the scroller's view timeline: progress is 0 when
// the top of .scroller reaches the top of the viewport and 1 when its
// bottom reaches the bottom (the "contain" range set in the style below).
// The offsets here are percentages of that timeline: slide screenshots
// crossfade in REVEAL_START + index * STEP percent in, and on narrow
// layouts each sticky card fades out CARD_HOLD percent after its
// screenshot has fully appeared, to make room for the next card.
const REVEAL_START = 3;
const CROSSFADE = 3;
const CARD_HOLD = 4;
const END_MARGIN = 1;
const STEP =
  (100 - REVEAL_START - CROSSFADE - END_MARGIN) / (slides.length - 1);

const pct = (value: number) => Math.round(value * 100) / 100;

// The animation-name rules are gated on the .animated class, which the
// script below only adds once scroll-driven animations work (natively or
// through the polyfill). Without it the section stays a static image
// with all cards readable instead of freezing in some animation state.
//
// animation-timeline and animation-range are declared together with
// animation-name instead of in the shared rule below: the polyfill only
// pairs a timeline with an animation when both appear in the same rule
// (a name-only rule processed later hides an earlier timeline-only rule).
const timelineProps = `
    animation-timeline: --scroller;
    animation-range: contain 0% contain 100%;`;

// view-timeline-name must live in this inline style block, not in the
// scoped style below: the prod build moves scoped styles into a linked
// stylesheet, which the polyfill fetches asynchronously. The .animated
// class is added right after the polyfill import resolves, so the 1ms
// animations finish on the document timeline before the fetch completes
// and the polyfill never finds the --scroller timeline (every image ends
// at opacity 1). Inline style tags are parsed synchronously at polyfill
// init, so declaring the timeline here removes the race.
const timelineCss = `
.scroller {
  view-timeline-name: --scroller;
}`;

const animationCss = slides
  .map((slide, index) => {
    const revealStart = REVEAL_START + index * STEP;
    const cardFadeStart = revealStart + CROSSFADE + CARD_HOLD;
    const imageCss = `
@keyframes reveal-${slide.name} {
  ${pct(revealStart)}% { opacity: 0; }
  ${pct(revealStart + CROSSFADE)}%, 100% { opacity: 1; }
}
.scroller.animated img.${slide.name} {
  animation-name: reveal-${slide.name};${timelineProps}
}`;
    // Keyframe offsets above 100% are invalid CSS, so a card whose
    // fade-out would land there (the last one) just stays visible.
    // The card rule is only meant for narrow layouts, but the polyfill
    // parser does not see rules nested in a media query, so it applies
    // at every width and the wide layout switches it off in the style
    // block below.
    const cardCss =
      cardFadeStart + 1 > 100
        ? ""
        : `
@keyframes hide-${slide.name} {
  ${pct(cardFadeStart)}% { opacity: 1; }
  ${pct(cardFadeStart + 1)}%, 100% { opacity: 0; }
}
.scroller.animated .card.${slide.name} {
  animation-name: hide-${slide.name};${timelineProps}
}`;
    return imageCss + cardCss;
  })
  .join("\n");
---

<Section class="scroller-section">
  <div class="text">
    <H level="2">Comprehensive AI-powered analysis</H>
    <p>
      Our automated algorithm suite aims to perform nearly all the same
      diagnostic tasks as healthcare professionals, enhancing every step of the
      analysis process rather than just optimizing isolated aspects. The rich
      data covering cell classification, morphological features, cell clusters,
      dysplasia assessment, and whole-slide descriptors are also available for
      educational and research purposes.
    </p>
  </div>
  <ContentBlock class="scroller">
    <ApplicationFrame class="screen">
      <Image src={baseImage} class="base" alt="" widths={W} height="600" />
      {
        slides.map((slide) => (
          <Image
            src={slide.image}
            class={slide.name}
            alt=""
            widths={W}
            height="600"
          />
        ))
      }
    </ApplicationFrame>

    {
      slides.map((slide) => (
        <Card class={`card ${slide.name} ${slide.position}`}>
          <h3>{slide.cardTitle}</h3>
          <p>{slide.cardBody}</p>
        </Card>
      ))
    }
  </ContentBlock>
</Section>

<style is:inline set:html={timelineCss + animationCss}></style>

<script>
  // The scroller is driven by CSS scroll-driven animations; browsers
  // without support get the polyfill instead. The animations only engage
  // once .animated is set, so if this script does not run or the polyfill
  // fails to load the section degrades to a static base screenshot with
  // all cards readable.
  if (
    !CSS.supports("animation-timeline: --works") ||
    !CSS.supports("view-timeline-name: --works")
  ) {
    await import("scroll-timeline-polyfill/dist/scroll-timeline.js");
  }
  document.querySelector(".scroller")?.classList.add("animated");
</script>

<style>
  /* Preserve the spacing the pre-merge Section variant used to provide. */
  .scroller-section {
    gap: calc(2 * var(--element-padding));
    padding-block: calc(2 * var(--element-padding));
  }
  /* we need this specificity hack to compensate for nondeterministic astro css order */
  .scroller.scroller {
    width: 100%;
    position: relative;

    display: grid;
    grid-auto-rows: minmax(600px, 1fr);
    grid-template-columns: 1fr;
    gap: 5rem;
    justify-items: center;
    align-items: center;

    background-color: var(--background-2);
    border-radius: var(--element-border-radius);
    padding: var(--element-padding);

    /* view-timeline-name is declared in the inline style block above so
       the scroll-timeline polyfill can parse it synchronously. */
  }
  .screen {
    position: sticky;
    top: 15%;
    display: grid;
    grid-template-areas: "img";
  }

  img {
    grid-area: img;
    height: auto;

    max-height: 70vh;
    width: auto;
  }
  img:not(:first-child) {
    opacity: 0;
  }
  .screen > img,
  .scroller .card {
    /* animation-name, -timeline and -range come from the generated
       per-slide style above. Any fixed duration spans the whole timeline
       range; the polyfill does not understand duration "auto". */
    animation-duration: 1ms;
    animation-timing-function: linear;
    animation-fill-mode: both;
  }

  .card {
    padding: calc(0.5 * var(--element-padding));
    z-index: 1;
    max-width: 35rem;
  }
  .left {
    justify-self: flex-start;
  }
  .right {
    justify-self: flex-end;
  }

  @media screen and (width >= 50em) {
    .card {
      /* Cards only fade out on narrow layouts, but the generated rules
         cannot express that with a media query (the polyfill would not
         see them), so the wide layout switches the animation off here.
         !important because the generated rules come later in the
         cascade and would win otherwise. */
      animation-name: none !important;
    }
  }

  @media screen and (width < 50em) {
    .scroller {
      align-items: flex-end;
    }
    .screen {
      align-self: flex-start;
      z-index: 2;
    }
    .card {
      margin-inline: 1em;
      justify-self: center;
      position: sticky;
      top: 16%;
    }
  }
</style>
