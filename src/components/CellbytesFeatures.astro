---
import CellularityIcon from "~src/assets/icons/assessments/cellularity.svg";
import ClustersIcon from "~src/assets/icons/assessments/clusters.svg";
import MegakaryocytesIcon from "~src/assets/icons/assessments/megakaryocyte-count.svg";
import ShapeIcon from "~src/assets/icons/assessments/shape.svg";
import SizeIcon from "~src/assets/icons/assessments/size.svg";
import SufficiencyIcon from "~src/assets/icons/assessments/sample-sufficiency.svg";

import Section from "~src/components/Section.astro";
import H from "~src/components/HeadingLink.astro";
import Glyphs from "~src/components/AssessmentGlyphs.astro";
import Dysplasias from "~src/components/DysplasiaTypes.astro";
import CellClasses from "~src/components/CellClassBrowser.astro";

/**
 * The measurements that are not a cell class, each with the glyph that stands
 * for it. `art` is the artwork.css class that repaints the icon from theme
 * tokens; the icons carry their exported colors otherwise.
 */
const MORPHOLOGY = [
  { name: "Size", icon: SizeIcon, art: "art-icon-size" },
  { name: "Shape", icon: ShapeIcon, art: "art-icon-shape" },
];
const SAMPLE_LEVEL = [
  { name: "Clusters", icon: ClustersIcon, art: "art-icon-clusters" },
  {
    name: "Megakaryocyte count",
    icon: MegakaryocytesIcon,
    art: "art-icon-megakaryocytes",
  },
  { name: "Cellularity", icon: CellularityIcon, art: "art-icon-cellularity" },
  {
    name: "Sample sufficiency",
    icon: SufficiencyIcon,
    art: "art-icon-sufficiency",
  },
];
---

<Section class="features">
  <section class="subsection">
    <H level="2">Data catalogue</H>
    <p class="lead">
      Cellbytes delivers a comprehensive cytomorphological assessment, including
      whole-slide analysis, cell classification, and dysplasia detection. Every
      algorithm is built on high-quality data covering normal and pathological
      varieties, cutting-edge research and validated by robust scientific and
      clinical metrics. By trusting Cellbytes, you will receive an extensive
      data package.
    </p>
  </section>

  <div class="sample-type">
    <H level="3">Bone marrow samples</H>

    <section class="subsection">
      <H level="4" class="label">Cell differentials and dysplasias</H>
      <CellClasses sample="bone-marrow" />
    </section>

    <section class="subsection">
      <h4 class="label">Dysplasias</h4>
      <Dysplasias sample="bone-marrow" />
    </section>

    <div class="assessments">
      <section class="subsection">
        <H level="4" class="label">Morphology</H>
        <Glyphs items={MORPHOLOGY} />
      </section>
      <section class="subsection">
        <H level="4" class="label">Sample-level</H>
        <Glyphs items={SAMPLE_LEVEL} />
      </section>
    </div>
  </div>

  <div class="sample-type">
    <H level="3">Peripheral blood samples</H>

    <section class="subsection">
      <H level="4" class="label">Cell differentials</H>
      <CellClasses sample="peripheral-blood" />
    </section>

    <section class="subsection">
      <H level="4" class="label">Dysplasias</H>
      <Dysplasias sample="peripheral-blood" />
    </section>

    <section class="subsection">
      <H level="4" class="label">Morphology</H>
      <Glyphs items={MORPHOLOGY} />
    </section>
  </div>
</Section>

<style>
  .features {
    gap: calc(4 * var(--element-padding));
  }
  .subsection {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--element-padding);
    width: 100%;
  }
  .lead {
    max-width: 60ch;
  }

  .sample-type {
    width: 100%;
    max-width: 64em;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(2 * var(--element-padding));
  }

  /* The sub-headings inside a sample type are labels over the block they
     introduce, in the brand magenta the design uses to separate them from the
     navy headings above. */
  .label {
    color: var(--logo-magenta);
  }

  /* Morphology and the sample-level measures sit side by side under the
     classes, each glyph over the name of what it measures. */
  .assessments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(2 * var(--element-padding));
    text-align: center;

    .subsection {
      width: auto;
    }
  }
</style>
