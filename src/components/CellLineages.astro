---
export interface Lineage {
  name: string;
  /** The color the application paints this lineage's cells with. */
  color: string;
  /** Marked with an asterisk, meaning the dysplasia assessment covers it. */
  dysplasia?: boolean;
  members: (string | { name: string; members: string[] })[];
}

interface Props {
  lineages: Lineage[];
}
const { lineages } = Astro.props;

const marked = lineages.some(
  (lineage) =>
    lineage.dysplasia ||
    lineage.members.some((m) => typeof m === "string" && m.endsWith("*")),
);
---

<div>
  <ul class="lineages">
    {
      lineages.map((lineage) => (
        <li style={`--lineage: ${lineage.color}`}>
          <span class="lineage">
            {lineage.name}
            {lineage.dysplasia && " *"}
          </span>
          {lineage.members.length > 0 && (
            <ul>
              {lineage.members.map((member) =>
                typeof member === "string" ? (
                  <li>{member}</li>
                ) : (
                  <li>
                    {member.name}
                    <ul>
                      {member.members.map((sub) => (
                        <li>{sub}</li>
                      ))}
                    </ul>
                  </li>
                ),
              )}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
  {marked && <p class="footnote">* Assessed for dysplasia.</p>}
</div>

<style>
  /* One column down the page, each lineage measured by its own accent bar so
     the groups read as the branches of a single list. */
  .lineages {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }
  .lineages > li {
    border-inline-start: 3px solid var(--lineage);
    padding-inline-start: 0.75em;
  }
  .lineage {
    color: var(--text-color-heading);
  }
  .lineages ul {
    list-style: none;
    padding-inline-start: 0.75em;
  }

  .footnote {
    font-size: var(--text-size-label);
    opacity: 0.75;
    margin-block-start: var(--element-padding);
  }
</style>
